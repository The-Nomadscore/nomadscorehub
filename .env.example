# Copy this file to .env and fill in as needed. Never commit .env itself.

# Base URL for city data. Points at the public Teleport API in Phase 1.
# In Phase 2, this will be swapped to point at our own Flask backend
# (e.g. http://localhost:5000/api) with zero changes required in
# any component — only services/api.js reads this value.
VITE_API_BASE_URL=https://api.teleport.org/api

# Set to "true" to force services/api.js to serve from mockData.js
# instead of hitting the live network. Useful when building UI in
# parallel before the live integration is wired up, or if the
# Teleport API is rate-limiting us.
VITE_USE_MOCK_DATA=true