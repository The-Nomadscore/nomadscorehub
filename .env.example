# Copy this file to .env and fill in as needed. Never commit .env itself.

# Base URL of the Flask backend (Phase 2). Include /api, no trailing slash.
# Local default shown. On Vercel, set this to the deployed backend URL in
# the project's environment settings. Only services/api.js reads this value.
VITE_API_BASE_URL=http://localhost:5000/api

# Set to "true" to force services/api.js to serve from mockData.js
# instead of hitting the live network. Useful when building UI in
# parallel before the live integration is wired up, or if an external
# API is rate-limiting us.
VITE_USE_MOCK_DATA=false